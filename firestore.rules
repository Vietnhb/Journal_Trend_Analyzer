rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Audit entries are written only by the trusted Admin SDK. The web client
    // receives read-only access and must always use bounded list queries.
    match /admin_audit_logs/{logId} {
      allow get: if isAdmin();
      allow list: if isAdmin()
                  && request.query.limit != null
                  && request.query.limit <= 100;
      allow create, update, delete: if false;
    }

    // No other browser/mobile Firestore access is currently part of the app.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
